# Engine
ENGINE_VERSION=0.3.0

# Disk cache for adapter responses (default: apps/api/cache)
# ADAPTER_CACHE_DIR=./cache
# Optional paid Open-Meteo key (avoids shared free-tier daily limit)
# OPEN_METEO_API_KEY=

# CORS: comma-separated browser origins allowed to call the API ("*" = any)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

