# Engine
ENGINE_VERSION=0.2.0

# Data adapters: live (real public APIs) | mock (deterministic DEMO data, offline)
ADAPTERS=live
# Disk cache for adapter responses (default: apps/api/cache)
# ADAPTER_CACHE_DIR=./cache
# Optional paid Open-Meteo key (avoids shared free-tier daily limit)
# OPEN_METEO_API_KEY=

# CORS: comma-separated browser origins allowed to call the API ("*" = any)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM / Ollama (local only). LLM only narrates — report works without it.
LLM_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_S=12
OLLAMA_MAX_TOKENS=700
OLLAMA_TEMPERATURE=0.2

# Adapter timeouts
ADAPTER_TIMEOUT_S=20
